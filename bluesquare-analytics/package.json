{
  "name": "bluesquare-analytics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4400",
    "build": "next build",
    "start": "next start -p ${PORT:-4400}",
    "typecheck": "tsc --noEmit",
    "test:cloud-billing": "tsx --test src/lib/google-cloud-costs.test.ts",
    "test:luxhotel": "node --conditions=react-server --import tsx --test src/lib/luxhotel.test.ts",
    "test:channex": "tsx --test src/lib/channex-pricing.test.ts",
    "test:departments": "tsx --test src/lib/departments.test.ts",
    "test:recurring": "node --conditions=react-server --import tsx --test src/lib/finance-recurring.test.ts",
    "test:leads-api": "node --conditions=react-server --import tsx --test src/lib/lead-intake.test.ts",
    "test:notifications": "node --conditions=react-server --import tsx --test src/lib/notifications.test.ts",
    "test:lead-ai": "node --conditions=react-server --import tsx --test src/lib/lead-ai.test.ts",
    "reset-password": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx tools/reset-password.ts",
    "test:lux-feeds": "node --conditions=react-server --import tsx --test src/lib/lux-feeds.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@google-cloud/bigquery": "^9.2.0",
    "@google/genai": "2.24.0",
    "@ip-location-db/dbip-country-mmdb": "2.3.2026060120",
    "maxmind": "5.0.7",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.15",
    "typescript": "^5.9"
  }
}
