# Postgres connection. Leave empty locally to use the embedded database in ./data.
# Cloud SQL from Cloud Run (unix socket):
# DATABASE_URL=postgresql://analytics:PASSWORD@localhost/analytics?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# First sign-in: creates the first admin account (username + password). Add more users under Users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Long random string used to sign the login cookie: openssl rand -hex 32
SESSION_SECRET=

# Time zone used to group reports by day
REPORT_TIMEZONE=Europe/Tirane

# BlueBill API (the token itself is entered in Finance → Settings and stored encrypted)
BLUEBILL_API_URL=https://bluebill-745501573999.europe-north1.run.app/api/v1
# Optional: lets a scheduler call POST /api/finance/bluebill/sync and /api/finance/channex/sync
# with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Finance Reports: Google Cloud expenses stay in USD, separate from the EUR ledger.
# JSON array: [{"name":"Billing account","projectId":"your-project","datasetId":"all_billing_data","billingAccountId":"XXXXXX-XXXXXX-XXXXXX"}]
# Local auth: gcloud auth application-default login. Cloud Run uses its attached service account.
GOOGLE_CLOUD_BILLING_SOURCES=[]
# Maximum bytes scanned per account query (1 GiB); successful reads are cached for 15 minutes.
GOOGLE_CLOUD_BILLING_MAX_BYTES=1073741824

# LuxHotel System monitoring and Finance → Channex costs. Server-only; never prefix this with NEXT_PUBLIC_.
LUXHOTEL_API_KEY=

# Gemini (a Google AI Studio API key): AI lead import (Sales → AI import) and mapping imported columns. Server-only.
GEMINI_API_KEY=
# Optional, default gemini-2.5-flash
# GEMINI_MODEL=
