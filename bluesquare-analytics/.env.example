# Postgres connection. Leave empty locally to use the embedded database in ./data.
# Cloud SQL from Cloud Run (unix socket):
# DATABASE_URL=postgresql://analytics:PASSWORD@localhost/analytics?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# Dashboard login
ADMIN_PASSWORD=change-me
# Long random string used to sign the login cookie: openssl rand -hex 32
SESSION_SECRET=

# Time zone used to group reports by day
REPORT_TIMEZONE=Europe/Tirane
